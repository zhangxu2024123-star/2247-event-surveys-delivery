{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/member-space/event-survey/questions.schema.json",
  "title": "会后问卷题目定义",
  "description": "event_surveys.questions 的结构约束。运行时另有 app/survey_validation.py 做逐题语义校验（题号唯一、max_length 上限等），两者规则一致。",
  "type": "array",
  "minItems": 1,
  "maxItems": 20,
  "items": {
    "$ref": "#/$defs/question"
  },
  "$defs": {
    "questionId": {
      "type": "string",
      "pattern": "^q[1-9][0-9]*$",
      "description": "问卷内唯一，形如 q1、q2"
    },
    "option": {
      "type": "object",
      "required": ["id", "label"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 32 },
        "label": { "type": "string", "minLength": 1, "maxLength": 120 }
      }
    },
    "question": {
      "type": "object",
      "required": ["id", "type", "title"],
      "properties": {
        "id": { "$ref": "#/$defs/questionId" },
        "type": { "enum": ["single", "multi", "rating", "text"] },
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "required": { "type": "boolean" },
        "options": {
          "type": "array",
          "minItems": 2,
          "maxItems": 10,
          "items": { "$ref": "#/$defs/option" }
        },
        "min_select": { "type": "integer", "minimum": 0 },
        "max_select": { "type": "integer", "minimum": 1 },
        "scale": { "enum": ["star5", "nps"] },
        "max_length": { "type": "integer", "minimum": 1, "maximum": 500 }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "enum": ["single", "multi"] } }, "required": ["type"] },
          "then": { "required": ["options"] }
        },
        {
          "if": { "properties": { "type": { "const": "rating" } }, "required": ["type"] },
          "then": { "required": ["scale"] }
        },
        {
          "if": { "properties": { "type": { "const": "text" } }, "required": ["type"] },
          "then": { "required": ["max_length"] }
        }
      ]
    }
  }
}
